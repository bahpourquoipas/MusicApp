{
  "id": "/musicapp",
  "name": "MusicApp — prompteur pour musiciens",
  "short_name": "MusicApp",
  "description": "Paroles, accords, playlists et métronome pour la scène. Fonctionne sans réseau.",
  "lang": "fr",
